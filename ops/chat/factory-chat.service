[Unit]
Description=TuriMath factory chat
After=network-online.target
Wants=network-online.target

[Service]
User=turimath
WorkingDirectory=/home/turimath/mathlab/ops/chat
EnvironmentFile=/home/turimath/.turimath.env
Environment=PATH=/home/turimath/.local/bin:/home/turimath/.elan/bin:/usr/local/bin:/usr/bin:/bin
# Localhost only: agents can run commands on this machine, so the app is never exposed publicly.
ExecStart=/home/turimath/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8601
Restart=always
# Port 8601: TuriChips has 8600 on the same VM. Tailscale serves it on port 8443.
# The VM is 2 vCPU / 8 GB today and also runs TuriChips and Halyard prod, so the caps below are
# sized for that and MACHINE_MAX_RUNNING=1 in the env file. After the upgrade to 32 GB: MemoryHigh=12G,
# MemoryMax=14G, MACHINE_MAX_RUNNING=3. Agents' jobs (Lean builds against Mathlib) run inside this
# unit's cgroup: past MemoryHigh they get throttled, past MemoryMax the kernel kills the biggest process here,
# and OOMPolicy=continue keeps the app (and the other turns) running. CPUWeight keeps ssh and the rest responsive.
MemoryHigh=3500M
MemoryMax=4500M
OOMPolicy=continue
CPUWeight=50
IOWeight=50
RestartSec=5

[Install]
WantedBy=multi-user.target
